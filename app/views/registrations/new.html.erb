<h2>Create an Account</h2>

<%= form_with model: @user, url: signup_path, local: true do |f| %>
  <% if @user.errors.any? %>
    <div style="color: red;">
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :email %><br>
    <%= f.email_field :email, required: true %>
  </div>
  <br>

  <div>
    <%= f.label :password %><br>
    <%= f.password_field :password, required: true %>
  </div>
  <br>

  <div>
    <%= f.label :password_confirmation %><br>
    <%= f.password_field :password_confirmation, required: true %>
  </div>
  <br>

  <!-- Account Type Selection -->
  <div style="background: #f9f9f9; padding: 15px; border: 1px solid #ddd; border-radius: 5px;">
    <strong>What would you like to do?</strong><br><br>
    
    <div>
      <%= radio_button_tag :account_type, "user", true %> 
      <%= label_tag :account_type_user, "I want to shop for products" %>
    </div>
    
    <div style="margin-top: 10px;">
      <%= radio_button_tag :account_type, "owner" %> 
      <%= label_tag :account_type_owner, "I want to open a store and sell products" %>
    </div>
  </div>
  <br>

  <%= f.submit "Sign Up" %>
<% end %>

<p>Already have an account? <%= link_to "Log in", login_path %></p>